<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.nihaoljx</groupId>
    <artifactId>flowchart</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>flowchart</name>
    <description>flowchart</description>
    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-boot.version>3.2.0</spring-boot.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.3.0</version>
        </dependency>

        <!-- ELK（Eclipse Layout Kernel）Java 版：分层布局的备选引擎。
             只取 core + layered 两个算法包，EPL-2.0 许可；
             不引任何 Xtext/Graphviz 相关件。见 docs/architecture.md ADR-4 备注 -->
        <dependency>
            <groupId>org.eclipse.elk</groupId>
            <artifactId>org.eclipse.elk.core</artifactId>
            <version>0.12.0</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.elk</groupId>
            <artifactId>org.eclipse.elk.alg.layered</artifactId>
            <version>0.12.0</version>
        </dependency>
        <!-- ELK 的 pom 漏声明了 Xtext 运行时（Eclipse 环境由 target
             platform 提供，纯 Maven 项目必须自己补），否则一加载
             LayeredMetaDataProvider 就 NoClassDefFoundError -->
        <dependency>
            <groupId>org.eclipse.xtext</groupId>
            <artifactId>org.eclipse.xtext.xbase.lib</artifactId>
            <version>2.36.0</version>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                    <!--
                        必须显式开启 -parameters。
                        本项目没有继承 spring-boot-starter-parent（改用 dependencyManagement
                        手动 import spring-boot-dependencies），因此父 POM 默认设置的
                        maven.compiler.parameters=true 不会继承过来。
                        后果：class 文件里不带形参名，Spring 的
                        @RequestParam / @PathVariable / @RequestHeader 若不写显式名字，
                        绑定阶段就抛
                        "Name for argument of type [java.lang.String] not specified,
                         and parameter name information not found in class file either."
                        （2026-09-16 实测踩到：PATCH /api/model/positions 全 500）。
                    -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>io.github.nihaoljx.flowchart.FlowchartApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                v2-7：Java 侧静态检查（相当于后端的 ESLint）。
                规则集在项目根 checkstyle.xml，故意做成"最小集"，接上是干净的（零误报）。
                不绑定生命周期阶段：由 run-verify.ps1 第 3 步显式调用 checkstyle:check，
                避免每次 mvn test 都多跑一遍、拖慢本地开发循环。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.3.1</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>10.12.4</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>${project.basedir}/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <!--
                        此处元素名必须是 inputEncoding（mojo 的字段名）。写成 <encoding> 会被
                        IDEA 按插件描述符校验判为"此处不允许使用元素"——encoding 只是该参数的
                        用户属性名，等价于命令行 -Dencoding=...，不能当配置元素用。
                        参数默认值即 ${project.build.sourceEncoding}，这里显式写出，不依赖继承。
                    -->
                    <inputEncoding>UTF-8</inputEncoding>
                    <violationSeverity>error</violationSeverity>
                    <failOnViolation>true</failOnViolation>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
