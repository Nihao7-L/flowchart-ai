{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://chartflow.local/schemas/scene.schema.json",
  "title": "Whiteboard Scene（白板元素场景 IR）",
  "description": "后端与前端共用的唯一真相源。场景=有序元素数组；数组顺序即 z 序（谁在后谁在上）。坐标为 LLM 给出的元素落点（px）：v2-41 起后端不再整体重排，采用原生坐标（你画在哪就显示在哪儿）；用户拖拽后回写。元素是 Excalidraw skeleton（程序化创建元素的官方简化格式）的精简子集。",
  "type": "object",
  "required": ["elements"],
  "additionalProperties": false,
  "properties": {
    "elements": {
      "type": "array",
      "items": { "$ref": "#/definitions/element" }
    },
    "schemaVersion": {
      "type": "string",
      "description": "IR 格式版本号（便于向前兼容）。后端生成时默认填 \"2.0\"；旧实例无此字段时按最新契约兼容处理。"
    }
  },
  "definitions": {
    "label": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": { "text": { "type": "string", "minLength": 1 } }
    },
    "point": {
      "type": "array",
      "description": "相对坐标 [dx,dy]：相对本元素 (x,y) 原点的偏移（Excalidraw skeleton 语义）",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "binding": {
      "type": "object",
      "description": "端点绑定：指向某元素 id",
      "required": ["id"],
      "additionalProperties": false,
      "properties": { "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" } }
    },
    "arrowhead": {
      "description": "箭头端点形状（渲染层字段：由后端按「关系语义」统一编译填入，LLM 不要输出）。crowfoot_* 是数据库 ER 图的基数标记；triangle_outline 常用于继承，bar 常用于起点。2026-09-18 实测：端点形状与端点绑定可共存，不必解绑。",
      "enum": ["arrow", "bar", "dot", "circle", "circle_outline", "triangle", "triangle_outline", "diamond", "diamond_outline", "crowfoot_one", "crowfoot_many", "crowfoot_one_or_many"]
    },
    "roundness": {
      "type": "object",
      "description": "圆角（渲染层字段：由后端按语义统一填入，LLM 不要输出）。Excalidraw 原生形态：{type:3} 自适应圆角（常用）、{type:2} 比例半径、{type:1} 旧版",
      "required": ["type"],
      "additionalProperties": false,
      "properties": { "type": { "enum": [1, 2, 3] } }
    },
    "verticalAlign": {
      "description": "文字在容器内的垂直对齐（渲染层字段，由后端填入，LLM 不要输出）",
      "enum": ["top", "middle", "bottom"]
    },
    "link": {
      "type": "string",
      "description": "超链接：点击该元素时跳转的 URL（可选）。给视觉元素指回文档 / 需求来源时用。"
    },
    "group": {
      "description": "所属模块名（自由文本，如「订单域」「支付服务」）。语义层字段：后端据此做结构规划，把同模块的图形排在一起、自动配色并算出成员所属的画框。**是否分区看需求语义，不设数量阈值**：需求里出现分层/分域/子系统（如接入层/服务层、订单域/支付域）就给该层图形填 group，需求没有分区语义就不要填。模块下还有子模块时可写成数组，从内到外排列（如 [\"下单\",\"订单域\"]）。**只写在图形（rectangle / ellipse / diamond）上**：画框靠自己的 name 认领模块，箭头 / 直线 / 文字上都不写 group（校验器 2026-09-24 起会拒掉，见 GraphValidator.SHAPE_TYPES）。",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "maxItems": 5
        }
      ]
    },
    "element": {
      "oneOf": [
        { "$ref": "#/definitions/shape" },
        { "$ref": "#/definitions/arrow" },
        { "$ref": "#/definitions/line" },
        { "$ref": "#/definitions/text" },
        { "$ref": "#/definitions/frame" },
        { "$ref": "#/definitions/freedraw" },
        { "$ref": "#/definitions/image" },
        { "$ref": "#/definitions/embeddable" },
        { "$ref": "#/definitions/magicframe" }
      ]
    },
    "shape": {
      "type": "object",
      "required": ["id", "type", "x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": { "enum": ["rectangle", "ellipse", "diamond"] },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "angle": { "type": "number", "description": "弧度，默认 0" },
        "label": { "$ref": "#/definitions/label" },
        "strokeColor": { "type": "string" },
        "backgroundColor": { "type": "string" },
        "fillStyle": { "enum": ["hachure", "cross-hatch", "solid", "zigzag", "dots", "dashed", "diagonal"] },
        "strokeStyle": { "enum": ["solid", "dashed", "dotted"] },
        "strokeWidth": { "type": "number", "minimum": 0 },
        "roughness": { "type": "number", "minimum": 0 },
        "roundness": { "$ref": "#/definitions/roundness" },
        "link": { "$ref": "#/definitions/link" },
        "group": { "$ref": "#/definitions/group" },
        "opacity": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "arrow": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": { "const": "arrow" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "points": { "type": "array", "items": { "$ref": "#/definitions/point" }, "minItems": 2 },
        "start": { "$ref": "#/definitions/binding" },
        "end": { "$ref": "#/definitions/binding" },
        "label": { "$ref": "#/definitions/label" },
        "strokeColor": { "type": "string" },
        "strokeWidth": { "type": "number", "minimum": 0 },
        "strokeStyle": { "enum": ["solid", "dashed", "dotted"] },
        "startArrowhead": { "$ref": "#/definitions/arrowhead" },
        "endArrowhead": { "$ref": "#/definitions/arrowhead" },
        "link": { "$ref": "#/definitions/link" },
        "opacity": { "type": "integer", "minimum": 0, "maximum": 100 },
        "relation": { "enum": ["flow", "call", "data", "async", "dependency", "one-to-one", "one-to-many", "many-to-many", "inherit", "block"] }
      }
    },
    "line": {
      "type": "object",
      "required": ["id", "type", "x", "y", "points"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": { "const": "line" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "points": { "type": "array", "items": { "$ref": "#/definitions/point" }, "minItems": 2 },
        "closed": {
          "type": "boolean",
          "description": "闭合线 = 多边形。true 时适配层会把 points 的首点补到末尾形成闭合环（Excalidraw 0.18 靠 points 首末点重合判定填充，没有 closed 布尔字段）；闭合后线围出的区域可被 backgroundColor / fillStyle 填充。用于画任意填充多边形 / 插画 / 等轴测伪 3D 方块；points 至少 3 个才有面积（含闭合点共 4 个）。"
        },
        "strokeColor": { "type": "string" },
        "backgroundColor": {
          "type": "string",
          "description": "闭合线填充色（配合 closed:true）。未闭合或不需要填充可不写，默认透明空心。"
        },
        "fillStyle": {
          "enum": ["hachure", "cross-hatch", "solid", "zigzag", "dots", "dashed", "diagonal"],
          "description": "闭合线填充纹理，配合 backgroundColor 使用（solid 最常用作实心填充）。"
        },
        "strokeWidth": { "type": "number", "minimum": 0 },
        "strokeStyle": { "enum": ["solid", "dashed", "dotted"] },
        "link": { "$ref": "#/definitions/link" },
        "opacity": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "text": {
      "type": "object",
      "required": ["id", "type", "x", "y", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": { "const": "text" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "text": { "type": "string", "minLength": 1 },
        "fontSize": { "type": "number", "minimum": 1 },
        "fontFamily": { "enum": [1, 2, 3], "description": "1=手绘 2=Helvetica 3=等宽" },
        "textAlign": { "enum": ["left", "center", "right"] },
        "verticalAlign": { "$ref": "#/definitions/verticalAlign" },
        "autoResize": {
          "type": "boolean",
          "description": "文字尺寸随内容自适应（渲染层字段，由后端填入，LLM 不要输出）"
        },
        "angle": { "type": "number" },
        "strokeColor": { "type": "string" },
        "link": { "$ref": "#/definitions/link" },
        "containerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "容器绑定：把本文字挂进某图形内当内文字（Excalidraw containerId）。与 shape.label 二选一，优先用 label。前端 sceneAdapter 已支持按此回填。"
        }
      }
    },
    "frame": {
      "type": "object",
      "description": "分组画框。`children` 是「框 ↔ 内容」归属的唯一途径（2026-09-18 对照实测：填了成员 id，成员的 frameId 才会被反填；不填则成员的 frameId 恒为 null，拖框带不走内容）。落法：由**后端**按分组与几何算出成员列表、前端适配层填入；LLM 不要输出 children（2026-09-17 拍板的动机不变，见 constraint.md 技术约束）。LLM 只需给 `name`，并尽量让它与图形的 `group` 模块名一致 —— 排版会按名字把框对齐到对应模块。",
      "required": ["id", "type", "x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": { "const": "frame" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "name": { "type": "string", "description": "画框标题，可空；与图形的 `group` 模块名一致时排版会把框对齐到该模块" },
        "children": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "description": "框内成员的 id 列表（渲染层字段：由后端按分组与几何算出后填入，LLM 不要输出）"
        },
        "link": { "$ref": "#/definitions/link" }
      }
    },
    "freedraw": {
      "type": "object",
      "required": ["id", "type", "x", "y", "points"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": { "const": "freedraw" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "points": { "type": "array", "items": { "$ref": "#/definitions/point" }, "minItems": 2 },
        "strokeColor": { "type": "string" },
        "strokeWidth": { "type": "number", "minimum": 0 },
        "opacity": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "image": {
      "type": "object",
      "description": "图片元素（前向兼容：当前提示词不产出，需由带 fileId 的上传接口补充）。fileId 是后端已上传图片的文件引用，LLM 无法自行生成，缺了 Excalidraw 无法渲染。",
      "required": ["id", "type", "x", "y", "width", "height", "fileId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": { "const": "image" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "fileId": { "type": "string", "description": "已上传图片文件引用（上传接口返回，LLM 不能造）" },
        "opacity": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "embeddable": {
      "type": "object",
      "description": "嵌入式网页（iframe；前向兼容）。需 url，当前提示词不产出。",
      "required": ["id", "type", "x", "y", "width", "height", "url"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": { "const": "embeddable" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "url": { "type": "string", "description": "要嵌入的外部网页地址" },
        "link": { "$ref": "#/definitions/link" }
      }
    },
    "magicframe": {
      "type": "object",
      "description": "魔法框（0.18 新增：可缩放视口 / 嵌入组；前向兼容，语义同 frame，但可被缩放）。children 由后端按分组与几何算出后填入；LLM 不要输出 children。",
      "required": ["id", "type", "x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "type": { "const": "magicframe" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "name": { "type": "string", "description": "画框标题，可空" },
        "children": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "description": "框内成员的 id 列表（渲染层字段：由后端填入，LLM 不要输出）"
        },
        "link": { "$ref": "#/definitions/link" }
      }
    }
  }
}
